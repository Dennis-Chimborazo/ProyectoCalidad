<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="techstore.TipoEquipoApp" owl="1">

        <div t-att-class="theme.classes.page">

            <TsPageHeader
                title="'Tipos de Equipo TechStore'"
                subtitle="'Administración de tipos de equipo: crear, editar, suspender y listar.'"
            >
                <t t-set-slot="actions">
                    <TsButton
                        label="'Actualizar'"
                        variant="'secondary'"
                        onClick.bind="loadTiposEquipo"
                    />
                </t>
            </TsPageHeader>

            <div class="ts-main-card">

                <div class="ts-client-toolbar">

                    <div class="ts-search-box">
                        <label>Buscar tipo de equipo</label>
                        <input
                            class="ts-search-input"
                            type="text"
                            placeholder="Buscar por nombre o descripción..."
                            t-att-value="state.search"
                            t-on-input="(ev) => this.updateSearch(ev.target.value)"
                        />
                    </div>

                    <TsButton
                        label="'+ Agregar Tipo'"
                        variant="'primary'"
                        onClick.bind="openCreateModal"
                    />

                </div>

                <t t-if="state.loading">
                    <div class="ts-loading-box">
                        Cargando tipos de equipo...
                    </div>
                </t>

                <t t-else="">
                    <TipoEquipoList
                        tiposEquipo="filteredTiposEquipo"
                        onEdit.bind="openEditModal"
                        onToggle.bind="toggleTipoEquipo"
                    />
                </t>

            </div>

            <t t-if="state.showModal">
                <TsModal
                    title="modalTitle"
                    subtitle="modalSubtitle"
                    onClose.bind="closeModal"
                >
                    <TipoEquipoForm
                        tipoEquipo="state.editingTipoEquipo"
                        onSave.bind="saveTipoEquipo"
                        onCancel.bind="closeModal"
                    />
                </TsModal>
            </t>

        </div>

    </t>

</templates>