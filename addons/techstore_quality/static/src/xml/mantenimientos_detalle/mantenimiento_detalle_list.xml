<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="techstore.MantenimientoDetalleList" owl="1">

        <div class="ts-invoice-section ts-maintenance-detail-list">

            <div class="ts-invoice-section-header">
                <div>
                    <h3>Equipos agregados</h3>
                    <p>Equipos asociados a esta orden y estado actual del mantenimiento.</p>
                </div>

                <button
                    type="button"
                    class="ts-btn ts-btn-secondary"
                    t-on-click="props.onRefresh"
                >
                    Actualizar
                </button>
            </div>

            <TsTable
                columns="columns"
                rows="rows"
                actions="actions"
                pageSize="10"
            />

        </div>

    </t>

</templates>