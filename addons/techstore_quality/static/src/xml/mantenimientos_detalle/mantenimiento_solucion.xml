<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="techstore.MantenimientoSolucion" owl="1">

        <div class="ts-maintenance-modal-form">

            <t t-if="state.error">
                <div class="ts-alert-error">
                    <t t-esc="state.error"/>
                </div>
            </t>

            <div class="ts-maintenance-subsection">
                <h4>Equipo en mantenimiento</h4>

                <div class="ts-selected-card">
                    <strong>
                        <t t-esc="props.item.equipo"/>
                    </strong>

                    <p>
                        <t t-esc="props.item.tipo_equipo"/>
                        |
                        <t t-esc="props.item.marca || 'Sin marca'"/>
                        |
                        <t t-esc="props.item.modelo || 'Sin modelo'"/>
                        |
                        Serie:
                        <t t-esc="props.item.numero_serie || 'Sin serie'"/>
                    </p>
                </div>
            </div>

            <div class="ts-maintenance-subsection">
                <h4>Falla reportada</h4>

                <div class="ts-info-box">
                    <t t-esc="props.item.falla_reportada || 'Sin falla reportada'"/>
                </div>
            </div>

            <div class="ts-maintenance-subsection">
                <h4>Gestión de solución</h4>

                <div class="ts-form-grid ts-form-grid-2">

                    <div class="ts-field">
                        <label>Estado del equipo</label>

                        <select
                            class="ts-input"
                            t-att-value="state.estado_equipo"
                            t-on-change="(ev) => this.updateField('estado_equipo', ev.target.value)"
                        >
                            <option value="pendiente">Pendiente</option>
                            <option value="en_proceso">En proceso</option>
                            <option value="finalizado">Finalizado</option>
                            <option value="cancelado">Cancelado</option>
                        </select>
                    </div>

                    <div class="ts-field ts-field-full">
                        <label>Solución aplicada</label>

                        <textarea
                            class="ts-input"
                            rows="4"
                            placeholder="Puede quedar vacío si todavía no existe solución..."
                            t-att-value="state.solucion"
                            t-on-input="(ev) => this.updateField('solucion', ev.target.value)"
                        />
                    </div>

                </div>
            </div>

            <div class="ts-maintenance-subsection">
                <h4>Base de conocimiento relacionada</h4>

                <div class="ts-field">
                    <label>Buscar falla documentada</label>

                    <input
                        class="ts-input"
                        type="text"
                        placeholder="Buscar por título, síntomas, causa, solución o palabras clave..."
                        t-att-value="state.search"
                        t-on-input="(ev) => this.updateField('search', ev.target.value)"
                    />
                </div>

                <t t-if="baseFiltrada.length">
                    <div class="ts-falla-selected-list">
                        <t t-foreach="baseFiltrada" t-as="base" t-key="base.id">

                            <div t-att-class="isSelected(base.id) ? 'ts-falla-card ts-falla-card-selected' : 'ts-falla-card'">

                                <div>
                                    <strong>
                                        <t t-esc="base.error_title"/>
                                    </strong>

                                    <p>
                                        <t t-esc="base.keywords || base.symptoms"/>
                                    </p>
                                </div>

                                <button
                                    type="button"
                                    t-att-class="isSelected(base.id) ? 'ts-btn ts-btn-danger ts-btn-sm' : 'ts-btn ts-btn-secondary ts-btn-sm'"
                                    t-on-click="() => this.toggleBase(base.id)"
                                >
                                    <t t-if="isSelected(base.id)">Quitar</t>
                                    <t t-else="">Agregar</t>
                                </button>

                            </div>

                        </t>
                    </div>
                </t>

                <t t-else="">
                    <div class="ts-empty">
                        No existen fallas documentadas para este tipo de equipo.
                    </div>
                </t>
            </div>

            <div class="ts-modal-actions">
                <TsButton
                    label="'Cancelar'"
                    variant="'secondary'"
                    onClick.bind="cancelar"
                />

                <TsButton
                    label="'Guardar gestión'"
                    variant="'primary'"
                    onClick.bind="guardar"
                />
            </div>

        </div>

    </t>

</templates>